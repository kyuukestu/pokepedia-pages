    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@pkmn/dex": "^0.10.11",
    "@primeuix/themes": "^1.2.5",
    "@supabase/supabase-js": "^2.115.0",
    "@types/lodash-es": "^4.17.12",
    "@vue-flow/core": "^1.48.2",
    "amqplib": "^0.10.9",
    "flag-icons": "^7.5.0",
    "fs": "^0.0.1-security",
    "fuse.js": "^7.5.0",
    "gh-pages": "^6.3.0",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.18.1",
    "lodash.debounce": "^4.0.8",
    "path": "^0.12.7",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "sql.js": "^1.14.2",
    "tailwind": "^4.0.0",
    "temporal-polyfill": "^1.0.4",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
