    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "~10.0.1",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^1.81.0",
    "prettier": "3.5.3",
    "supabase": "^2.116.0",
    "typescript": "~5.8.3",
    "unplugin-vue-router": "^0.19.2",
